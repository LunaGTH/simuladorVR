# This is a .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get very large and usually aren't useful to commit
/[Mm]emoryCaptures/

# Asset meta data should only be ignored for specific workflows, but generally kept:
# !/[Aa]ssets/**/*.meta

# Autogenerated Visual Studio / VS Code files
/[Ee]xportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated
/[Uu]nityGenerated/

# Packages
/[Pp]ackages/lock.json